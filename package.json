{
  "name": "surfbort",
  "version": "0.4.0",
  "description": "A React audio playlist player with a scrubbable waveform, built on wavesurfer.js",
  "keywords": [
    "react",
    "audio",
    "player",
    "playlist",
    "waveform",
    "wavesurfer",
    "music"
  ],
  "license": "MIT",
  "author": "Adam Beck",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "bin": {
    "surfbort": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./peaks": {
      "types": "./dist/peaks.d.ts",
      "default": "./dist/peaks.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "predev": "node scripts/make-demo-assets.mjs --if-missing",
    "dev": "vite --config playground/vite.config.ts",
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "demo:assets": "node scripts/make-demo-assets.mjs",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build && npm run test:e2e",
    "prepublishOnly": "npm run verify"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "wavesurfer.js": "^8.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "gifenc": "^1.0.3",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wavesurfer.js": "^8.0.3"
  }
}
